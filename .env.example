TMDB_API_KEY=your_tmdb_api_key_here
ADDON_URL=your_addon_url_here
PORT=7000

# Optional admin dashboard at /admin (leave empty to disable). Use a long random value, 16+ characters.
STATS_TOKEN=
# Where the stats file lives; mount it as a Docker volume so it survives redeploys
# STATS_DIR=/app/data
# Country lookup uses ~100 MB of RAM; set to 0 to turn it off
# STATS_GEO=1
# Timezone for the dashboard's days (and for when the image cache resets each night). Default: UTC
# TZ=America/New_York

# How long rendered images stay cached, in hours (default 48). 0 = expire at the next local midnight.
# IMAGE_CACHE_HOURS=48
